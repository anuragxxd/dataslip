{
  "name": "dataslip",
  "version": "0.1.0",
  "description": "A DataGrip-like TUI database editor for the terminal",
  "type": "module",
  "bin": {
    "dataslip": "./src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "start": "bun run src/index.tsx",
    "typecheck": "bunx tsc --noEmit",
    "test": "bash -lc 'bun test --preload ./test/preload.ts $(find ./test -name \"*.test.ts\" | sort)'",
    "test:watch": "bash -lc 'bun test --watch --preload ./test/preload.ts $(find ./test -name \"*.test.ts\" | sort)'",
    "test:coverage": "bash -lc 'mkdir -p coverage && set -o pipefail && bun test --coverage --preload ./test/preload.ts $(find ./test -name \"*.test.ts\" | sort) 2>&1 | tee coverage/summary.txt'",
    "coverage:check": "bun run ./scripts/check-coverage.ts coverage/summary.txt 75 70"
  },
  "dependencies": {
    "@opentui/core": "^0.1.90",
    "@opentui/react": "^0.1.90",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "zod": "3.24.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  }
}
